{
  "model": {
    "vocab_size": 32000,
    "hidden_size": 1536,
    "num_layers": 30,
    "intermediate_size": 4096,
    "num_attention_heads": 24,
    "num_key_value_heads": 6,
    "sequence_length": 2048,
    "rope_theta": 10000.0,
    "rms_norm_eps": 1e-5,
    "activation_checkpointing": true,
    "loss_chunk_tokens": 2048,
    "flash_attention": true
  },
  "training": {
    "seed": 42,
    "micro_batch_size": 4,
    "effective_batch_tokens": 131072,
    "target_tokens": null,
    "learning_rate": 0.0003,
    "min_lr_ratio": 0.1,
    "warmup_ratio": 0.01,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "max_grad_norm": 1.0,
    "num_workers": 2,
    "save_every_seconds": 1800,
    "keep_checkpoints": 3,
    "session_hours": 9,
    "stop_margin_seconds": 600,
    "eval_every_tokens": 100000000,
    "eval_tokens": 1048576,
    "log_every_steps": 10
  },
  "data_root": "data/processed/tokenized",
  "tokenizer": "data/processed/tokenizer/unigram_32k.model",
  "output_dir": "checkpoints/pretrain_800m"
}
